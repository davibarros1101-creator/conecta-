{
  "manifest_version": 3,
  "name": "Conecta+ | Reconheça golpes digitais",
  "short_name": "Conecta+",
  "description": "Pessoas reais. Conexões seguras. Pratique reconhecer golpes digitais comuns em situações simuladas.",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Conecta+ - Pratique reconhecer golpes digitais"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": ["tesseract/*", "face-models/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
